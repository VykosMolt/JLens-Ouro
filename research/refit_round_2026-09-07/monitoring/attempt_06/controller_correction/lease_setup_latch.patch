+def remember_worker_status(root, observed_state, status):
+    """Persist the first setup success for this lease/pod under the state lock."""
+    def apply(state):
+        if (state["name"] != observed_state["name"]
+                or state.get("pod_id") != observed_state.get("pod_id")
+                or status.get("lease_name") != state["name"]):
+            raise ValueError("worker status identity changed before persistence")
+        state["last_worker_status"] = status
+        if status.get("setup_complete") is True and not setup_completed_for_lease(state):
+            if not isinstance(state.get("pod_id"), str) or not state["pod_id"]:
+                raise ValueError("setup completion needs the bound pod identity")
+            state["setup_completion"] = {"lease_name": state["name"], "pod_id": state["pod_id"]}
+    return change(root, apply)
 
 
