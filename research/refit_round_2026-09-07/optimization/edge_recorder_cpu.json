  "model_definition": "class TiedBlock(CausalBlock):\n    def forward(self, hidden, *, current_ut):\n        return super().forward(hidden)\n\nclass RecurrentTiny(TinyDecoder):\n    def __init__(self):\n        super().__init__(n_layers=4, d_model=5, seed=20260907)\n        del self.layers\n        self.blocks = nn.ModuleList([TiedBlock(5), TiedBlock(5)])\n        self.layers = [LoopTap(block, loop) for loop in range(2) for block in self.blocks]\n\n    def forward(self, ids):\n        hidden = self.embed_tokens(ids)\n        for loop in range(2):\n            for block in self.blocks:\n                hidden = block(hidden, current_ut=loop)\n            hidden = self.norm(hidden)\n        return SimpleNamespace(last_hidden_state=hidden)\n",
