% Compact full-width divider for Paper 1's major parts and appendices.
\newcommand{\kirinpart}[2]{%
  \Needspace{5\baselineskip}%
  \vspace{1.25em}%
  \noindent\colorbox{KirinAccentPale}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      \vspace{0.35em}%
      {\sffamily\bfseries\fontsize{9pt}{10pt}\selectfont\color{KirinAccentDark}\MakeUppercase{#1}}%
      \ifstrempty{#2}{}{\hfill{\sffamily\bfseries\fontsize{15pt}{17pt}\selectfont\color{KirinInk}#2}}%
      \vspace{0.35em}}}%
  \par\vspace{0.55em}}

% The \pretocmd hooks above still supply \Needspace; only the visual format
% changes here.
\newcommand{\kirinappendixstyle}{%
  \titleformat{\section}
    {\sffamily\bfseries\color{KirinInk}\fontsize{13.2pt}{15.2pt}\selectfont}
    {}{0pt}{}%
  \titlespacing*{\section}{0pt}{1.25em plus .2em minus .1em}{0.4em}%
  \titleformat{\subsection}
    {\sffamily\bfseries\color{KirinInk}\fontsize{10.9pt}{12.8pt}\selectfont}
    {}{0pt}{}%
}

% Figures here are centred boxes followed by this caption, not floats, so the
% only thing holding the pair together is the penalty between them.
% \nopagebreak[4] forbids that break, so a caption can never be orphaned from
% its figure; \interlinepenalty then stops the caption splitting internally.
% Together they move the whole figure+caption unit to the next page when it
% will not fit.
\newcommand{\kirinfigcaption}[2]{%
  \nopagebreak[4]\par\nopagebreak[4]\vspace{3pt}\nopagebreak[4]%
  \begingroup\interlinepenalty=10000\relax
  \noindent{\small\sffamily\bfseries\color{KirinInk}#1}\enspace
  {\small\color{KirinMuted}#2}\par
  \endgroup\vspace{5pt}}

