\setlength{\parindent}{1.08em}
\setlength{\parskip}{0pt plus 0.4pt}
\setlength{\emergencystretch}{1.25em}
% Headings are visually unnumbered (the \titleformat label argument is empty),
% but the counters must still advance: with secnumdepth = -1 hyperref cannot
% build a unique \theH... anchor per heading, so nested headings collide, the
% "anchor of a bookmark and its parent's must not be the same" warning fires,
% and bookmark destinations resolve to the wrong page.
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}
\setlist{nosep,leftmargin=1.5em,topsep=3pt}

% \Needspace must run BEFORE the heading is typeset, not inside \titleformat's
% format argument: there it executes after hyperref has already written the
% anchor, so a page break triggered by it strands the anchor on the previous
% page. Prepending it to the sectioning commands keeps anchor and heading
% together.
\titleformat{\section}
  {\sffamily\bfseries\color{KirinAccent}\fontsize{15.2pt}{17.5pt}\selectfont}
  {}{0pt}{}
\titlespacing*{\section}{0pt}{1.45em plus .25em minus .15em}{0.50em}
\titleformat{\subsection}
  {\sffamily\bfseries\color{KirinInk}\fontsize{12.2pt}{14.2pt}\selectfont}
  {}{0pt}{}
\titlespacing*{\subsection}{0pt}{1.15em plus .2em minus .1em}{0.35em}
\titleformat{\subsubsection}
  {\sffamily\bfseries\color{KirinAccentDark}\fontsize{10.6pt}{12.3pt}\selectfont}
  {}{0pt}{}
\titlespacing*{\subsubsection}{0pt}{0.95em plus .15em minus .1em}{0.25em}
\titleformat{\paragraph}[runin]
  {\sffamily\bfseries\color{KirinInk}\normalsize}{}{0pt}{}[.]
\pretocmd{\section}{\Needspace{6\baselineskip}}{}{\PackageWarning{kirin-papers}{could not pretoc \string\section}}
\pretocmd{\subsection}{\Needspace{4\baselineskip}}{}{\PackageWarning{kirin-papers}{could not pretoc \string\subsection}}
\pretocmd{\subsubsection}{\Needspace{2.5\baselineskip}}{}{\PackageWarning{kirin-papers}{could not pretoc \string\subsubsection}}

